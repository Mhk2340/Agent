<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/security_card_background"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/home_title"
        android:textColor="@color/agent_text"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/home_lockdown_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="@color/agent_secondary_text"
        android:textSize="15sp" />

    <TextView
        android:id="@+id/home_lockdown_condition"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="@color/agent_warning"
        android:textSize="14sp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/home_crash_banner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/security_card_background"
        android:orientation="vertical"
        android:padding="10dp"
        android:visibility="gone">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/diagnostics_crash_banner"
            android:textColor="@color/agent_warning"
            android:textSize="13sp" />

        <Button
            android:id="@+id/home_crash_report_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/diagnostics_crash_open_report" />
    </LinearLayout>

    <Button
        android:id="@+id/open_local_chat_button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/open_local_chat_button" />

    <Button
        android:id="@+id/settings_button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/settings_button" />

    <Button
        android:id="@+id/recovery_button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/recovery_button"
        android:visibility="gone" />

    <Button
        android:id="@+id/lock_now_button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/lock_now_button" />
</LinearLayout>
