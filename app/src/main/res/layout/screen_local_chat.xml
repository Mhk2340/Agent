<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/agent_background"
    android:layoutDirection="locale"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingTop="8dp"
    android:paddingEnd="12dp"
    android:paddingBottom="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <Button
            android:id="@+id/local_chat_back_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="48dp"
            android:text="@string/local_chat_back" />

        <TextView
            android:id="@+id/local_chat_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/local_chat_title"
            android:textColor="@color/agent_text"
            android:textSize="18sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/local_chat_new_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="48dp"
            android:text="@string/local_chat_new" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/local_chat_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="4dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="ifContentScrolls"
        android:paddingBottom="8dp">

        <LinearLayout
            android:id="@+id/local_chat_messages"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="2dp"
            android:paddingEnd="2dp">

            <TextView
                android:id="@+id/local_chat_welcome"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="40dp"
                android:gravity="center"
                android:text="@string/local_chat_welcome"
                android:textColor="@color/agent_text"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textDirection="firstStrong" />

            <TextView
                android:id="@+id/local_chat_welcome_detail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginTop="10dp"
                android:layout_marginEnd="20dp"
                android:gravity="center"
                android:text="@string/local_chat_welcome_detail"
                android:textColor="@color/agent_secondary_text"
                android:textSize="15sp"
                android:textDirection="firstStrong" />
        </LinearLayout>
    </ScrollView>

    <Button
        android:id="@+id/local_chat_jump_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:text="@string/local_chat_jump_bottom"
        android:visibility="gone" />

    <TextView
        android:id="@+id/local_chat_context_note"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:background="@drawable/security_card_background"
        android:padding="8dp"
        android:text="@string/local_chat_context_trimmed"
        android:textColor="@color/agent_secondary_text"
        android:textSize="12sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/local_chat_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:textColor="@color/agent_secondary_text"
        android:textSize="12sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/local_chat_error"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:textColor="@color/agent_warning"
        android:textSize="13sp"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="bottom"
        android:orientation="horizontal">

        <EditText
            android:id="@+id/local_chat_input"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/security_card_background"
            android:gravity="top|start"
            android:hint="@string/local_chat_input_hint"
            android:imeOptions="actionSend|flagNoExtractUi"
            android:inputType="textCapSentences|textMultiLine|textAutoCorrect"
            android:importantForAutofill="no"
            android:maxLines="5"
            android:minLines="1"
            android:padding="12dp"
            android:textColor="@color/agent_text"
            android:textColorHint="@color/agent_secondary_text"
            android:textDirection="firstStrong" />

        <Button
            android:id="@+id/local_chat_send_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:minWidth="72dp"
            android:text="@string/local_chat_send" />
    </LinearLayout>
</LinearLayout>
