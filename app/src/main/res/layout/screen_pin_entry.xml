<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/security_card_background"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/pin_entry_title"
        android:textColor="@color/agent_text"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="12dp"
        android:text="@string/pin_entry_description"
        android:textColor="@color/agent_secondary_text"
        android:textSize="15sp" />

    <EditText
        android:id="@+id/pin_input"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/pin_label"
        android:importantForAutofill="no"
        android:inputType="numberPassword"
        android:maxLength="12"
        android:saveEnabled="false"
        android:singleLine="true"
        android:textDirection="ltr" />

    <TextView
        android:id="@+id/screen_message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="@color/agent_warning"
        android:textSize="14sp"
        android:visibility="gone" />

    <Button
        android:id="@+id/primary_button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/pin_unlock_button" />

    <Button
        android:id="@+id/biometric_button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/biometric_unlock_button"
        android:visibility="gone" />
</LinearLayout>
