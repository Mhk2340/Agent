<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/security_card_background"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/settings_title"
        android:textColor="@color/agent_text"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:text="@string/settings_description"
        android:textColor="@color/agent_secondary_text"
        android:textSize="14sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/provider_gemini"
        android:textColor="@color/agent_text"
        android:textSize="17sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/gemini_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="@color/agent_secondary_text"
        android:textSize="13sp" />

    <EditText
        android:id="@+id/gemini_key_input"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/api_key_hint"
        android:importantForAutofill="no"
        android:inputType="textPassword"
        android:saveEnabled="false"
        android:singleLine="true"
        android:textDirection="ltr" />

    <Button
        android:id="@+id/gemini_save_button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/save_key_button" />

    <Button
        android:id="@+id/gemini_remove_button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="@string/remove_key_button" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/provider_groq"
        android:textColor="@color/agent_text"
        android:textSize="17sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/groq_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="@color/agent_secondary_text"
        android:textSize="13sp" />

    <EditText
        android:id="@+id/groq_key_input"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/api_key_hint"
        android:importantForAutofill="no"
        android:inputType="textPassword"
        android:saveEnabled="false"
        android:singleLine="true"
        android:textDirection="ltr" />

    <Button
        android:id="@+id/groq_save_button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/save_key_button" />

    <Button
        android:id="@+id/groq_remove_button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="@string/remove_key_button" />

    <!-- // PROVISIONAL - pending GEN-PERF-1 -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="@string/model_import_title"
        android:textColor="@color/agent_text"
        android:textSize="17sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/model_import_description"
        android:textColor="@color/agent_secondary_text"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/model_import_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textColor="@color/agent_secondary_text"
        android:textSize="13sp" />

    <Button
        android:id="@+id/settings_model_import_button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/model_import_button" />

    <LinearLayout
        android:id="@+id/local_model_developer_tools_section"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/security_card_background"
        android:orientation="vertical"
        android:padding="8dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/local_model_developer_tools_title"
            android:textColor="@color/agent_text"
            android:textSize="16sp"
            android:textStyle="bold" />

    <Button
        android:id="@+id/settings_local_model_self_test_button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:enabled="false"
        android:text="@string/local_model_self_test_button" />

    <TextView
        android:id="@+id/local_model_self_test_quick_question"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:text="@string/local_model_self_test_order_quick"
        android:textColor="@color/agent_secondary_text"
        android:textSize="12sp" />

    <Button
        android:id="@+id/settings_local_model_prefill_test_button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:enabled="false"
        android:text="@string/local_model_self_test_prefill_button" />

    <Button
        android:id="@+id/settings_local_model_sweep_test_button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:enabled="false"
        android:text="@string/local_model_self_test_sweep_button"
        android:visibility="gone" />

    <Button
        android:id="@+id/local_model_self_test_cancel_button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/local_model_self_test_cancel_button"
        android:visibility="gone" />

    <TextView
        android:id="@+id/local_model_self_test_progress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="@color/agent_secondary_text"
        android:visibility="gone" />

    <TextView
        android:id="@+id/local_model_self_test_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/agent_text"
        android:visibility="gone" />

    <TextView
        android:id="@+id/local_model_self_test_metrics"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/agent_secondary_text"
        android:visibility="gone" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="@string/timeout_title"
        android:textColor="@color/agent_text"
        android:textSize="17sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/timeout_description"
        android:textColor="@color/agent_secondary_text"
        android:textSize="14sp" />

    <Spinner
        android:id="@+id/timeout_spinner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:entries="@array/background_timeout_labels"
        android:saveEnabled="false" />

    <Button
        android:id="@+id/timeout_save_button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/timeout_save_button" />

    <Switch
        android:id="@+id/biometric_switch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:saveEnabled="false"
        android:text="@string/biometric_setting"
        android:textColor="@color/agent_text" />

    <Button
        android:id="@+id/biometric_save_button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/biometric_save_button" />

    <TextView
        android:id="@+id/screen_message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="@color/agent_warning"
        android:textSize="14sp"
        android:visibility="gone" />

    <Button
        android:id="@+id/settings_diagnostics_button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/diagnostics_button" />

    <Button
        android:id="@+id/settings_panic_reset_button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="@string/panic_reset_button" />

    <Button
        android:id="@+id/settings_recovery_button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/recovery_button" />

    <Button
        android:id="@+id/settings_back_button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/back_button" />

    <Button
        android:id="@+id/settings_lock_button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/lock_now_button" />
</LinearLayout>
